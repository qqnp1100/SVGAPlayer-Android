  "findingsFixed": [
    {
      "issue": "A coroutine cancelled while waiting on decodeLock still decoded and published its frame after acquiring the monitor",
      "fix": "Pass the request CoroutineContext into preparation; check cancellation after acquiring decodeLock, before each image, after native decode and before publication; recycle cancelled results and roll back their reservations; do not cache CancellationException as a malformed-image failure",
      "regressionTest": "cancellationWhileWaitingForTheDecoderSkipsTheNativeDecode"
    },
    {
      "issue": "close dropped all current Bitmap references, including never-drawn prefetched pixels, leaving safe-to-release native allocations to GC",
      "fix": "Recycle private pixels immediately unless referenced by a hardware display list or an in-progress draw; preserve shared eager pixels; keep close idempotent",
      "regressionTests": [
        "closingRecyclesUnshownPrefetchWithoutRecyclingSharedImages",
        "closingKeepsPixelsPinnedByAnInProgressDraw"
      ],
      "additionalAssertions": [
        "Close cancels and completes only its own prefetch worker",
        "The current hardware frame remains unrecycled after clear"
      ]
    }
  ],
